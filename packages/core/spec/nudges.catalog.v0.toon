# Current counts:
# - Clarity      : 7
# - Respect      : 5
# - Empathy      : 1
# - Actionability: 6
# - Specificity  : 3



nudge clarify_request:
  goal: Actionability
  trigger: ambiguity
  micro_copy: "State who, what, and when."
  before: "Can you handle it?"
  after: "@Alex, can you send the draft by Fri 5pm?"

nudge soften_blame:
  goal: Respect
  trigger: accusation_blame
  micro_copy: "Remove blame—focus on the task, not the person."
  before: "You never sent the report."
  after: "I’m missing the report-can you share it?"

nudge add_empathy:
  goal: Empathy
  trigger: missing_acknowledgment
  micro_copy: "Add a brief acknowledgment before your request."
  before: "Send me the draft."
  after: "Thanks for working on this, could you send me the draft?"

nudge remove_vagueness:
  goal: Clarity
  trigger: vague_time_or_action
  micro_copy: "Replace vague terms with specific details."
  before: "Let’s do this soon."
  after: "Let’s finalize this by tomorrow 5pm."

nudge confirm_understanding:
  goal: Clarity
  trigger: ambiguous_statement
  micro_copy: "Add a short confirmation to ensure both sides mean the same thing."
  before: "Okay, I'll handle it."
  after: "Okay, I'll handle the client deck revisions, is that what you meant?"

nudge add_rationale:
  goal: Actionability
  trigger: request_without_reason
  micro_copy: "Add a brief reason so the request becomes easier to act on."
  before: "Please update the file."
  after: "Please update the file, we need the latest numbers for tomorrow’s meeting."

nudge reduce_intensity:
  goal: Respect
  trigger: harsh_tone
  micro_copy: "Soften the intensity to keep the message constructive."
  before: "This is completely wrong."
  after: "This seems off, can we review it together?"

nudge tighten_scope:
  goal: Specificity
  trigger: broad_statement
  micro_copy: "Narrow the scope so the message becomes clearer."
  before: "We should improve this."
  after: "Let’s improve the onboarding flow’s first two screens."

nudge specify_owner:
  goal: Actionability
  trigger: missing_owner
  micro_copy: "Name who is responsible so the task becomes executable."
  before: "This needs to be fixed."
  after: "@Alex, can you fix this before tomorrow’s sync?"

nudge add_deadline:
  goal: Actionability
  trigger: missing_timeframe
  micro_copy: "Add a clear deadline to make the request executable."
  before: "Can you send the draft?"
  after: "Can you send the draft by today 6pm?"

nudge set_boundary:
  goal: Respect
  trigger: unclear_expectation
  micro_copy: "Set a clear boundary to avoid over-commitment or confusion."
  before: "I’ll try to get to it."
  after: "I can take this on, but I’ll deliver it tomorrow morning."

nudge split_overlong:
  goal: Clarity
  trigger: long_sentence
  micro_copy: "Break long sentences into two shorter points."
  before: "We need to finalize the proposal and update the metrics and prepare the slide deck."
  after: "Let’s finalize the proposal first. Then update the metrics and prep the slide deck."

nudge replace_idiom:
  goal: Clarity
  trigger: cultural_risk
  micro_copy: "Swap idioms for neutral language that works globally."
  before: "Let's crush this meeting."
  after: "Let's make this meeting a success."

nudge confirm_next_step:
  goal: Actionability
  trigger: unclear_next_step
  micro_copy: "Add the next step so the message becomes executable."
  before: "Okay, sounds good."
  after: "Okay, sounds good — so I’ll finalize the draft and send it by noon?"

nudge polite_request:
  goal: Respect
  trigger: direct_imperative
  micro_copy: "Turn a command into a polite request."
  before: "Send me the file."
  after: "Could you send me the file when you get a moment?"

nudge remove_padding:
  goal: Clarity
  trigger: unnecessary_fillers
  micro_copy: "Cut filler phrases so the point is sharper."
  before: "Basically, I just wanted to kind of check in about the update."
  after: "I wanted to check in about the update."

nudge add_context:
  goal: Clarity
  trigger: missing_background
  micro_copy: "Add one line of context so the reader understands the situation."
  before: "We need to change this."
  after: "Based on the client feedback, we need to change this."

nudge quantify_statement:
  goal: Specificity
  trigger: vague_quantity
  micro_copy: "Add numbers to make the statement measurable."
  before: "The results are much better now."
  after: "The results improved by 18% compared to last week."

nudge deescalate_tension:
  goal: Respect
  trigger: escalating_emotion
  micro_copy: "Add a calming phrase to reduce tension."
  before: "This is getting ridiculous."
  after: "Let’s slow down and sort this out together."

nudge reduce_hedging:
  goal: Clarity
  trigger: excessive_hedging
  micro_copy: "Remove extra hedges so your message sounds clear and confident."
  before: "I think maybe we could possibly try updating it?"
  after: "We should update it."

nudge firm_up_commitment:
  goal: Actionability
  trigger: weak_commitment
  micro_copy: "Turn a vague commitment into a specific and reliable one."
  before: "I’ll try to get it done."
  after: "I’ll complete it by tomorrow 2pm."

nudge clarify_status:
  goal: Specificity
  trigger: vague_status_update
  micro_copy: "Turn a vague status into a clear, trackable update."
  before: "I’m working on it."
  after: "I’m 60% done — finishing the last section today."

nudge acknowledge_effort:
  goal: Empathy
  trigger: missing_positive_ack
  micro_copy: "Briefly acknowledge the other person’s effort or time."
  before: "Can you update the numbers?"
  after: "Thanks for your work on this — could you update the numbers?"

