nudge clarify_request:
  goal: Actionability
  trigger: ambiguity
  micro_copy: "State who, what, and when."
  before: "Can you handle it?"
  after: "@Alex, can you send the draft by Fri 5pm?"

nudge soften_blame:
  goal: Respect
  trigger: accusation_blame
  micro_copy: "Remove blame—focus on the task, not the person."
  before: "You never sent the report."
  after: "I’m missing the report—can you share it?"

nudge add_empathy:
  goal: Empathy
  trigger: missing_acknowledgment
  micro_copy: "Add a brief acknowledgment before your request."
  before: "Send me the draft."
  after: "Thanks for working on this — could you send me the draft?"

nudge remove_vagueness:
  goal: Clarity
  trigger: vague_time_or_action
  micro_copy: "Replace vague terms with specific details."
  before: "Let’s do this soon."
  after: "Let’s finalize this by tomorrow 5pm."

nudge confirm_understanding:
  goal: Clarity
  trigger: ambiguous_statement
  micro_copy: "Add a short confirmation to ensure both sides mean the same thing."
  before: "Okay, I'll handle it."
  after: "Okay, I'll handle the client deck revisions — is that what you meant?"

nudge add_rationale:
  goal: Actionability
  trigger: request_without_reason
  micro_copy: "Add a brief reason so the request becomes easier to act on."
  before: "Please update the file."
  after: "Please update the file — we need the latest numbers for tomorrow’s meeting."

